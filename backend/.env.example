DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cloudnest
PORT=3000
TRUST_PROXY_HOPS=0
NODE_ENV=production
PUBLIC_ORIGIN=https://your-backend-domain.example
WEBSITE_ORIGIN=https://cloud-nest-studio.hanglimbu6221.chatgpt.site
# A persistent mounted directory, never an ephemeral deployment directory.
UPLOAD_DIR=/var/data/cloud-nest/uploads
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Optional email notification provider; submissions are stored even if email fails.
RESEND_API_KEY=
MAIL_FROM=
NOTIFY_EMAIL=Hanglimbu6221@gmail.com
